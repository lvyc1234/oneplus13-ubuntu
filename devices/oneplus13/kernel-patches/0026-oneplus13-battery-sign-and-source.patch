+/* Read the phone's source and current in one serialized firmware exchange. */
+static int qcom_battmgr_phone_status(struct qcom_battmgr *battmgr,
+				    union power_supply_propval *val)
+{
+	bool online;
+	s32 current_now;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_ONLINE, 0);
+	if (ret)
+		goto out;
+	online = battmgr->usb.online;
+	if (!online) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_WLS_PROPERTY_GET,
+						   WLS_ONLINE, 0);
+		if (ret)
+			goto out;
+		online = battmgr->wireless.online;
+	}
+	if (!online) {
+		val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		goto out;
+	}
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_CURR_NOW, 0);
+	if (ret)
+		goto out;
+	/* This quirk is paired with BATT_CURRENT_INVERTED on this phone. */
+	current_now = battmgr->status.current_now;
+	if (current_now < 0) {
+		val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		goto out;
+	}
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_CAPACITY, 0);
+	if (ret)
+		goto out;
+	val->intval = battmgr->status.percent == 100 ? POWER_SUPPLY_STATUS_FULL :
+		     POWER_SUPPLY_STATUS_NOT_CHARGING;
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
